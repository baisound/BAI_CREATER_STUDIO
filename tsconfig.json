{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "paths": {
      "/v01641_preview_guard.js": [
        "./studio/types/legacy/v01641_preview_guard.d.ts"
      ],
      "/camera_follow_config.js": [
        "./studio/types/legacy/camera_follow_config.d.ts"
      ],
      "/camera_follow_smoothing.js": [
        "./studio/types/legacy/camera_follow_smoothing.d.ts"
      ],
      "/camera_3d.js": [
        "./studio/types/legacy/camera_3d.d.ts"
      ]
    }
  },
  "include": [
    "studio/js/**/*.js",
    "studio/js/**/*.d.ts",
    "studio/types/**/*.d.ts"
  ]
}
