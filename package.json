{
  "name": "bai-creator-studio",
  "private": true,
  "version": "0.0.0-recovery",
  "description": "Local development hot reload for the existing Python-backed BAI Creator Studio",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names API,LIVE \"npm:dev:api\" \"npm:dev:live\"",
    "dev:api": "nodemon --config nodemon.json",
    "dev:live": "browser-sync start --config bs-config.cjs",
    "start": "python server.py 8765",
    "test:dev-config": "node --test tests/dev-workflow.test.cjs",
    "typecheck": "tsc -p tsconfig.json",
    "test:studio": "node --test tests/studio-ui.test.cjs",
    "test:studio-routes": "python -m pytest -q tests/test_studio_routes.py",
    "test:p2-e2e": "node tests/run-guarded.cjs tests/studio-p2-e2e-main.test.cjs && node tools/record_e2e_main.mjs",
    "test:node-all": "node tests/run-guarded.cjs \"tests/*.test.cjs\" \"tests/*.test.mjs\" \"test_camera_*.cjs\" \"test_camera_*.mjs\""
  },
  "devDependencies": {
    "browser-sync": "^3.0.4",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.10",
    "playwright": "^1.56.1",
    "three": "0.160.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
